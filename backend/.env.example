# Server Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/gsc_announcements
NODE_ENV=development

# Clerk Authentication Keys (HOD Accounts)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# UploadThing Credentials (File Uploads)
UPLOADTHING_TOKEN=your_uploadthing_token

# Super Admin Secret for HOD Approval Route
ADMIN_SECRET=super_secret_admin_approval_key_123

# VAPID Keys for Web Push Notifications
# Generate with: npx web-push generate-vapid-keys
# IMPORTANT: Set these on Render/production to avoid key regeneration on redeploys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
